          },
          "expr": "{service_name=\"parser_avito\", instance=~\"$instance\", subsystem=\"blocking\", level=~\"$level\"} |= ${search:doublequote} | json | line_format \"{{.message}}{{if .exception}}\\n{{.exception}}{{end}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
