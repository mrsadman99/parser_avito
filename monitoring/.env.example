# Relative log paths are resolved from the repository root (the Compose file).
AVITO_LOG_DIR=./logs
AVITO_INSTANCE=avito-server

# Use an SSH tunnel, or set a server bind address and GRAFANA_ROOT_URL explicitly.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001/
GRAFANA_ADMIN_USER=admin
# make monitoring-init generates a random password in monitoring/.env.
GRAFANA_ADMIN_PASSWORD=
